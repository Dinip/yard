# Static file server for the SPA. The outer Caddy terminates TLS and routes
# /api to the coordinator before anything reaches here.
:80 {
	root * /srv
	encode zstd gzip

	# Hashed asset filenames are immutable; index.html must never be cached or
	# clients pin to a stale bundle after a deploy.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
