# Copy to .env and fill in. Used by docker compose and by `bun run dev`.

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=yard
POSTGRES_PASSWORD=yard
POSTGRES_DB=yard
POSTGRES_PORT=5432
DATABASE_URL=postgres://yard:yard@localhost:5432/yard

# ── Coordinator ─────────────────────────────────────────────────────────────
PORT=3000
# Public origin of the coordinator. Must match the OAuth redirect URI host.
PUBLIC_URL=http://localhost:3000
# Comma-separated origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173
# openssl rand -base64 32
AUTH_SECRET=replace-me-with-at-least-32-characters-of-entropy

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Entra ID app registration. Redirect URI: <PUBLIC_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Bootstraps the first admin locally. Turn off once Microsoft sign-in works.
ENABLE_EMAIL_PASSWORD=true

# ── Session tokens (browser ↔ provider) ─────────────────────────────────────
# Ed25519 PKCS#8 PEM. Generated in memory at boot if unset, which invalidates
# live sessions on restart — set it in production.
#   openssl genpkey -algorithm ed25519 -out session.pem
SESSION_TOKEN_PRIVATE_KEY=
SESSION_TOKEN_TTL=60
RESERVATION_TTL=900

# ── Images (docker compose only) ────────────────────────────────────────────
# `latest` follows releases, `edge` the tip of main, or pin a version: 1.2.3
VERSION_TAG=latest

# ── Deployment (docker compose only) ────────────────────────────────────────
# ":80" for local, or a hostname like "yard.example.com" for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# ── Provider (docker compose --profile provider) ────────────────────────────
# Issue under /admin/providers in the UI. Shown once.
YARD_PROVIDER_TOKEN=
YARD_LOG=info
