# Copy to .env and fill in. Used by docker compose and by `bun run dev`.
#
# Grouped by deploy unit, because the units deploy separately. A single-host
# `docker compose up` wants all of it; a split deployment takes its own section
# plus the shared values below. Details: docs/DEPLOYMENT.md.

# ── Shared across deploy units ──────────────────────────────────────────────
#   POSTGRES_USER/PASSWORD/DB  postgres + coordinator + migrations
#   DATABASE_URL               coordinator + migrations
#   PUBLIC_URL (host)          coordinator + caddy (SITE_ADDRESS) + provider.yaml
#   WEB_ORIGIN                 must be the origin serving the SPA, or CORS fails
#   FARM_PROVIDER_TOKEN        issued by the coordinator, held by the provider

# ── images (every unit but postgres) ────────────────────────────────────────
# A release version (1.2.3), a commit sha, `latest`, or `pr-N`. Pin in production.
IMAGE_TAG=latest

# ── postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=farm                # also: coordinator, migrations (DATABASE_URL)
POSTGRES_PASSWORD=farm            # also: coordinator, migrations (DATABASE_URL)
POSTGRES_DB=farm                  # also: coordinator, migrations (DATABASE_URL)
# Published port on the host. postgres only — the compose network uses 5432.
POSTGRES_PORT=5432

# ── migrations (packages/db) ────────────────────────────────────────────────
DATABASE_URL=postgres://farm:farm@localhost:5432/farm   # also: coordinator
# Only when the SQL does not sit in the package.
# MIGRATIONS_DIR=

# ── coordinator ─────────────────────────────────────────────────────────────
# Reads DATABASE_URL above as well.
PORT=3000
# NODE_ENV=production
# Public origin of the coordinator. Must match the OAuth redirect URI host.
PUBLIC_URL=http://localhost:3000  # also: caddy (SITE_ADDRESS), provider.yaml
# Comma-separated origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173  # also: caddy (the site it serves the SPA on)
# openssl rand -base64 32
AUTH_SECRET=replace-me-with-at-least-32-characters-of-entropy
# The one place the product name lives. Coordinator only — the SPA reads it
# over the API. See docs/RENAMING.md.
APP_NAME=Device Farm

# ── coordinator: sign-in ────────────────────────────────────────────────────
# Entra ID app registration. Redirect URI: <PUBLIC_URL>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Bootstraps the first admin locally. Turn off once Microsoft sign-in works.
ENABLE_EMAIL_PASSWORD=true

# ── coordinator: session tokens (browser ↔ provider) ────────────────────────
# Ed25519 PKCS#8 PEM. Generated in memory at boot if unset, which invalidates
# live sessions on restart — set it in production.
#   openssl genpkey -algorithm ed25519 -out session.pem
SESSION_TOKEN_PRIVATE_KEY=
SESSION_TOKEN_TTL=60
RESERVATION_TTL=900

# ── web + caddy ─────────────────────────────────────────────────────────────
# The SPA bundle is static; these belong to the proxy in front of it.
# ":80" for local, or a hostname for automatic HTTPS. Must be PUBLIC_URL's host.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Dev only: where `bun run dev` proxies /api.
# COORDINATOR_URL=http://localhost:3000

# ── provider (docker compose --profile provider) ────────────────────────────
# Issue under /admin/providers in the UI. Shown once.
FARM_PROVIDER_TOKEN=
FARM_LOG=info
# Session plane port. Must match provider.yaml's bind/public_base_url.
# PROVIDER_PORT=7100
# macOS dev only: the iOS backend reaches the host's usbmuxd over a bridge.
# USBMUXD_BRIDGE_PORT=27015

# ── provider on its own host (docker-compose.provider.yml) ──────────────────
# Also needs a provider.yaml. See docs/DEPLOYMENT.md.
# PROVIDER_SITE_ADDRESS=lab-1.example.com   # same hostname as public_base_url
# PROVIDER_CONFIG=/etc/farm/provider.yaml
# PROVIDER_CADDYFILE=/etc/farm/Caddyfile
# METRICS_BIND_ADDRESS=127.0.0.1            # no auth on this port
# METRICS_PORT=9100
