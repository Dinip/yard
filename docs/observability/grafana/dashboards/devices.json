{
  "title": "Device farm \u2014 devices",
  "uid": "farm-devices",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "farm-prometheus"
        },
        "query": "label_values(yard_device_status, device)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1,
        "sort": 1,
        "definition": "label_values(yard_device_status, device)",
        "label": "Device"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU busy",
      "description": "Everything but idle, as a fraction of total CPU time. Derived from counters, so the window follows the dashboard's.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(yard_device_cpu_seconds_total{device=~\"$device\",mode!=\"idle\"}[5m])) / sum by (device) (rate(yard_device_cpu_seconds_total{device=~\"$device\"}[5m]))",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "farm-prometheus"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "yard_device_memory_used_bytes{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "farm-prometheus"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Temperature",
      "description": "Battery temperature, plus any thermal zone the device let us read. A phone that throttles here streams badly and fails tests in ways that look like flaky software.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "yard_device_battery_temperature_celsius{device=~\"$device\"}",
          "legendFormat": "{{device}} battery",
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "expr": "yard_device_thermal_zone_celsius{device=~\"$device\"}",
          "legendFormat": "{{device}} {{zone}}",
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "farm-prometheus"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Battery",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "yard_device_battery_level_ratio{device=~\"$device\"}",
          "legendFormat": "{{device}}",
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "farm-prometheus"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Watched apps \u2014 PSS",
      "description": "Only processes matching metrics.app_patterns in provider.yaml.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "yard_app_memory_pss_bytes{device=~\"$device\"}",
          "legendFormat": "{{device}} {{app}}",
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "farm-prometheus"
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Device status",
      "description": "Each device's status over time. `busy` is reconstructed by the provider from its own status plus an authorized reservation \u2014 the provider itself never reports that word. A gap means the exporter stopped answering; a device that is merely gone still reports a status.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "absent",
                  "color": "#8e8e8e",
                  "index": 0
                },
                "2": {
                  "text": "present",
                  "color": "#3274d9",
                  "index": 1
                },
                "3": {
                  "text": "preparing",
                  "color": "#eab839",
                  "index": 2
                },
                "4": {
                  "text": "ready",
                  "color": "#56a64b",
                  "index": 3
                },
                "5": {
                  "text": "busy",
                  "color": "#b877d9",
                  "index": 4
                },
                "6": {
                  "text": "unhealthy",
                  "color": "#e02f44",
                  "index": 5
                }
              }
            }
          ],
          "color": {
            "mode": "fixed"
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "farm-prometheus"
          },
          "expr": "1 * sum by (device) (yard_device_status{device=~\"$device\",status=\"absent\"}) + 2 * sum by (device) (yard_device_status{device=~\"$device\",status=\"present\"}) + 3 * sum by (device) (yard_device_status{device=~\"$device\",status=\"preparing\"}) + 4 * sum by (device) (yard_device_status{device=~\"$device\",status=\"ready\"}) + 5 * sum by (device) (yard_device_status{device=~\"$device\",status=\"busy\"}) + 6 * sum by (device) (yard_device_status{device=~\"$device\",status=\"unhealthy\"})",
          "legendFormat": "{{device}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "farm-prometheus"
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
