{
  "name": "device-farm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --filter '*' --elide-lines 0 dev",
    "dev:coordinator": "bun run --filter '@farm/coordinator' dev",
    "dev:web": "bun run --filter '@farm/web' dev",
    "db:generate": "bun run --filter '@farm/db' generate",
    "db:migrate": "bun run --filter '@farm/db' migrate",
    "db:studio": "bun run --filter '@farm/db' studio",
    "build": "bun run --filter '*' build",
    "protocol:gen": "bun packages/protocol/scripts/gen-rust.ts",
    "protocol:check": "bun test packages/protocol && bun run protocol:gen && git diff --exit-code -- packages/provider/crates/farm-protocol",
    "test": "bun test packages/protocol packages/coordinator/test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
